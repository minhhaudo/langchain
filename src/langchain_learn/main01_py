from dotenv import load_dotenv
from langchain.agents import create_agent
from langchain.tools import tool
from langchain_core.messages import SystemMessage, HumanMessage
from langchain_ollama import ChatOllama

load_dotenv()


def search(query: str) -> str:
    """
    Tool  that researchs over internet
    Args:
        query (str): The query to search for 
    Returns:
        The search results
    """
    print(f"Searching for: {query}")
    return "Tokyo wheather is sunny"


llm = ChatOllama(temperature=0, model="llama3.1")
tools = [search]
agent = create_agent(model=llm, tools=tools)


def main():
    print("Hello from langchain-learn! ")
    result = agent.invoke({"message":HumanMessage(content="What is Tokyo the weather like today?")})

if __name__ == "__main__":
    main()
